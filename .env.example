# Synapse Stream runs without any of these. Leave them unset to use the
# preview leaderboard, which stores daily scores on the machine running the
# Next.js server.

# Where the preview leaderboard keeps scores: "file" (default, .data/scores.json)
# or "memory" (lost on restart; used by the browser tests).
LEADERBOARD_STORE=file

# Optional Supabase backend. Server only: never prefix these with NEXT_PUBLIC_.
# The service role key bypasses Row Level Security and must stay on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
