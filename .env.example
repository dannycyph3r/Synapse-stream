# Synapse Stream runs without any of these. Leave them unset to use the
# preview leaderboard, which stores daily scores on the machine running the
# Next.js server.

# Where the preview leaderboard keeps scores: "file" (default locally,
# .data/scores.json) or "memory" (lost on restart; used by the browser tests).
# On Vercel the file store cannot work, so memory is used automatically.
LEADERBOARD_STORE=

# Optional Supabase backend for a real shared leaderboard. On Vercel, set these
# under Settings > Environment Variables. Server only: never prefix them with
# NEXT_PUBLIC_.
# The service role key bypasses Row Level Security and must stay on the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
