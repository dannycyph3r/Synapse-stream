# SYNAPSE runs without any of these. Leave them unset to use the preview
# leaderboard, which stores daily scores on the machine running the Next.js
# server (or, on Vercel, temporarily in server memory).

# Force a preview store: "file" (.data/scores.json) or "memory" (lost on
# restart; used by the browser tests). When set, it overrides Supabase, so
# local test runs never write to a real project.
LEADERBOARD_STORE=

# Real shared leaderboard. Server only: never prefix these with NEXT_PUBLIC_.
# On Vercel, set them under Settings > Environment Variables (Production).
# Project Settings > API in Supabase: the Project URL (https://<ref>.supabase.co).
SUPABASE_URL=
# A secret key (sb_secret_...). A legacy service_role key also works, in
# either this variable or SUPABASE_SERVICE_ROLE_KEY. It bypasses Row Level
# Security, so it must stay on the server.
SUPABASE_SECRET_KEY=

# Optional, only for `npm run check:leaderboard`: the publishable key
# (sb_publishable_...), used to confirm browsers cannot read player ids.
SUPABASE_PUBLISHABLE_KEY=
